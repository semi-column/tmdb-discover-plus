{
  "name": "tmdb-discover-plus",
  "version": "2.10.5",
  "description": "TMDB Discover+ - Custom Catalog Builder for Stremio",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "start": "node --experimental-strip-types src/index.ts",
    "dev": "node --experimental-strip-types --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node tests/run-integration.js"
  },
  "keywords": [
    "stremio",
    "addon",
    "tmdb",
    "catalog"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.5",
    "node-cache": "^5.1.2",
    "pg": "^8.23.0",
    "rate-limit-redis": "^6.0.1",
    "redis": "^6.2.1"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.0",
    "fast-check": "^4.9.0",
    "msw": "^2.15.0",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
