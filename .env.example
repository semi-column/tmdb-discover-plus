# TMDB Discover+ environment template
# Setup: docs/self-hosting.md | Reference: docs/environment.md
# Replace all secret placeholders before starting. Never commit your .env.
# npm start loads .env from the repository root. The dev server changes into
# server/; export settings or use DOTENV_CONFIG_PATH=../.env npm run dev.
# Compose .env interpolation only forwards variables declared in environment/env_file.

# Required: generate TWO separate values with openssl rand -hex 32
JWT_SECRET=replace-with-a-separately-generated-secret
ENCRYPTION_KEY=replace-with-exactly-64-generated-hex-characters

# Persistence: postgres, mongo, memory. Configure one matching URI.
# The postgres/redis defaults below require reachable local services.
# For a disposable local test use memory for BOTH drivers and clear Redis URLs.
# Memory storage loses all configurations on restart.
DATABASE_DRIVER=postgres
POSTGRES_URI=postgresql://tmdb:replace-with-url-encoded-password@localhost:5432/tmdb_discover
# MONGODB_URI=mongodb://localhost:27017/tmdb-discover-plus
# Containers use service names (e.g. postgres), not localhost.
# Managed platforms: map DATABASE_URL to POSTGRES_URI; DATABASE_URL alone is unused.

CACHE_DRIVER=redis
REDIS_URL=redis://localhost:6379
# CACHE_MAX_KEYS=20000
# CACHE_WARM_REGIONS=US,GB,DE,FR,ES
# CACHE_VERSION_OVERRIDE=

PORT=7000
NODE_ENV=production
# Public origin, no trailing slash; use HTTPS for remote hosting.
# BASE_URL=https://addon.example.com
# Proxy trust: 0 directly, 1 for exactly one trusted proxy.
TRUST_PROXY=0
# JSON_BODY_LIMIT=512kb
CORS_ORIGIN=*
# CORS_ALLOW_CREDENTIALS=false
LOG_LEVEL=info
# LOG_FORMAT=json
# Development/test only; ignored in production:
# DISABLE_RATE_LIMIT=false

# Optional instance TMDB default for shared/background work.
# Users still sign in with their own key from https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# TMDB_RATE_LIMIT=35
# DEBUG_TMDB=false

# Artwork provider defaults; users may also configure their own credentials.
RPDB_API_KEY=t0-free-rpdb
# TOP_POSTERS_API_KEY=
# FANART_API_KEY=

# Optional compatible IMDb API service (not provisioned by this application).
# IMDB_DATA_ENABLED=true
# IMDB_DATA_KEY=
# IMDB_DATA_HOST=api.example.com
# IMDB_DATA_ATTR_K=x-api-key
# IMDB_DATA_ATTR_H=x-api-host
# IMDB_DATA_RATE_LIMIT=5
# IMDb TTL overrides in seconds:
# IMDB_CACHE_TTL_SEARCH=86400
# IMDB_CACHE_TTL_DETAIL=604800
# IMDB_CACHE_TTL_RANKING=86400
# IMDB_CACHE_TTL_POPULAR=21600
# IMDB_CACHE_TTL_LIST=21600
# IMDB_CACHE_TTL_REFERENCE=2592000

# Independent IMDb ratings dataset enrichment:
# IMDB_RATINGS_DISABLED=false
# IMDB_RATINGS_UPDATE_HOURS=24
# IMDB_MIN_VOTES=100

# Other sources (AniList and Kitsu do not require instance keys):
# MAL_CLIENT_ID=
# MAL_RATE_LIMIT=3
# JIKAN_API_BASE=https://api.jikan.moe/v4
# SIMKL_CLIENT_ID=
# SIMKL_RATE_LIMIT=5

# Optional nightly identity and smaller resource defaults:
# ADDON_VARIANT=nightly
# Nightly defaults: TMDB_RATE_LIMIT=12, CACHE_MAX_KEYS=6000, CACHE_WARM_REGIONS=US.
# Startup warming is skipped; IMDb source/ratings remain environment-driven.

# Optional admin/observability: disabled until username plus password/hash is set.
# Plain password: minimum 16 characters. Hash alternative:
# npm --prefix server run admin:hash
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
# ADMIN_PASSWORD_HASH=
# ADMIN_TOTP_SECRET=
# ADMIN_ALLOWED_IPS=
# Enable ONLY when ingress verifies Cloudflare provenance/strips forged CF headers:
# TRUST_CLOUDFLARE_HEADERS=false
# OBS_SAMPLE_RATE=1
# OBS_RETENTION_DAYS=7
# OBS_MAX_STORAGE_MB=1024
# OBS_REDIS_URL=
# OBS_ALERT_WEBHOOK_URL=
